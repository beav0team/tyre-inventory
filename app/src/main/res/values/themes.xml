<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base (light) theme. The modern look comes from Compose Material 3. -->
    <style name="Theme.Inventory" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>